{
  "name": "frontend-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "一个基于Vue3、Vite7、TypeScript、NaiveUI and UnoCSS的清新优雅前台模版。",
  "author": {
    "name": "Rouarn",
    "email": "woyuxiaji@foxmail.com",
    "url": "https://github.com/Rouarn"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/Rouarn/frontend-template",
  "scripts": {
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:prettier": "prettier --write .",
    "prepare": "husky",
    "lint:lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@sa/color": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vakao-ui/axios": "^0.0.1",
    "@vueuse/core": "^14.2.0",
    "axios": "^1.13.4",
    "clipboard": "^2.0.11",
    "consola": "^3.4.2",
    "dayjs": "^1.11.19",
    "defu": "^6.1.4",
    "localforage": "^1.10.0",
    "naive-ui": "^2.43.2",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "vfonts": "^0.0.3",
    "vue": "^3.5.27",
    "vue-cropper": "^1.1.4",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.1",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@iconify/json": "^2.2.434",
    "@iconify/utils": "^3.1.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.1.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "commitizen": "^4.3.1",
    "consola": "3.4.2",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "~10.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.97.3",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.4",
    "workbox-build": "^7.4.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{less,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "website": "http://www.shixian.xyz"
}
