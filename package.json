{
  "name": "frontend-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "一个基于Vue3、Vite8、TypeScript、NaiveUI and UnoCSS的清新优雅前台模版。",
  "author": {
    "name": "Rouarn",
    "email": "woyuxiaji@foxmail.com",
    "url": "https://github.com/Rouarn"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/Rouarn/frontend-template",
  "scripts": {
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:prettier": "prettier --write .",
    "prepare": "husky",
    "lint:lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@sa/color": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vakao-ui/axios": "^0.0.2",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "clipboard": "^2.0.11",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "defu": "^6.1.7",
    "localforage": "^1.10.0",
    "naive-ui": "^2.45.3",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "vfonts": "^0.0.3",
    "vue": "^3.5.43",
    "vue-cropper": "^1.1.4",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify/json": "^2.2.534",
    "@iconify/utils": "^3.1.7",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.3",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "~10.11.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "kolorist": "^1.8.0",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.4.1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{less,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "website": "http://www.shixian.xyz",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
