{
  "name": "frontend-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "一个基于Vue3、Vite8、TypeScript、NaiveUI and UnoCSS的清新优雅前台模版。",
  "author": {
    "name": "Rouarn",
    "email": "woyuxiaji@foxmail.com",
    "url": "https://github.com/Rouarn"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/Rouarn/frontend-template",
  "scripts": {
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:prettier": "prettier --write .",
    "prepare": "husky",
    "lint:lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@sa/color": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vakao-ui/axios": "^0.0.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "clipboard": "^2.0.11",
    "consola": "^3.4.2",
    "dayjs": "^1.11.21",
    "defu": "^6.1.7",
    "localforage": "^1.10.0",
    "naive-ui": "^2.44.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "vfonts": "^0.0.3",
    "vue": "^3.5.38",
    "vue-cropper": "^1.1.4",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@iconify/json": "^2.2.488",
    "@iconify/utils": "^3.1.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.0.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.2",
    "consola": "3.4.2",
    "cz-git": "^1.13.1",
    "eslint": "^10.5.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-vue": "~10.9.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "kolorist": "^1.8.0",
    "lint-staged": "^17.0.7",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.8.4",
    "sass-embedded": "^1.100.0",
    "terser": "^5.48.0",
    "typescript": "~6.0.3",
    "unocss": "^66.7.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vue-tsc": "^3.3.5",
    "workbox-build": "^7.4.1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{less,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "website": "http://www.shixian.xyz"
}
