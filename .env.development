# 本地环境
VITE_USER_NODE_ENV=development

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE=hash

# 打包时是否删除 console
VITE_DROP_CONSOLE=Y

# 开发环境接口地址
VITE_SERVICE_BASE_URL=/proxy-node

# 开发环境跨域代理，支持配置多个
VITE_PROXY='[["/proxy-default","http://127.0.0.1:8849"],["/proxy-node","http://150.158.128.228:8848"]]'
