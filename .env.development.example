# 本地环境
VITE_USER_NODE_ENV=development

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE=hash

# 开发环境接口地址
VITE_SERVICE_BASE_URL=/proxy-node

# 开发环境跨域代理，支持配置多个
# 本地后端（nestjs-template 默认 8848）；如需直连线上调试，追加 ["/proxy-remote","https://template.shixian.xyz"]
VITE_PROXY='[["/proxy-node","http://127.0.0.1:8848"]]'
