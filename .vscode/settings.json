{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json, env.d.ts",
    "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*, uno.config.ts",
    "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .prettier*, prettier*, .editorconfig, lint-staged.config.json, commitlint.config.ts",
    ".env": ".env, .env.production, .env.development"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxlint-vscode",
  "[vue]": {
    "editor.defaultFormatter": "oxc.oxlint-vscode"
  },
  "oxlint.run": "onSave",
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.suggest.autoImports": true,
  "i18n-ally.displayLanguage": "zh-cn",
  "i18n-ally.enabledParsers": ["ts"],
  "i18n-ally.enabledFrameworks": ["vue"],
  "i18n-ally.editor.preferEditor": true,
  "i18n-ally.keystyle": "nested",
  "i18n-ally.localesPaths": ["src/locales/langs"],
  "i18n-ally.parsers.typescript.compilerOptions": {
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "rootDir": "."
  }
}
